---
import SpaceCanvas from '../components/SpaceCanvas';
import Layout from '../layouts/Layout.astro';

---

<Layout title="Gabriel Mandrake | Full Stack Developer">
  <!-- Rocket speed-bar loading HUD: horizontal capsule, dark left half with
       fast stars + exhaust trail, white right half ahead of the rocket, rocket
       travels left→right inside the bar as progress fills. -->
  <div id="boot-hud" data-stage="loading" data-progress="0" aria-busy="true" class="fixed inset-0 z-[9999] flex items-center justify-center bg-black overflow-hidden">
    <div id="boot-canvas-wrap" class="absolute inset-0">
      <canvas id="boot-canvas" class="absolute inset-0 w-full h-full"></canvas>
    </div>

    <div class="relative z-10 flex flex-col items-center gap-10 select-none">
      <!-- Horizontal rocket speed bar (larger) -->
      <div class="relative w-[380px] h-[88px] md:w-[470px] md:h-[96px] flex items-center">
        <div class="relative w-full h-full rounded-full overflow-hidden border border-white/10 shadow-[0_0_48px_12px_rgba(135,243,255,0.18)]">
          <!-- White right half (destination, ahead of rocket) -->
          <div class="absolute inset-y-0 right-0 w-1/2 bg-white/90"></div>
          <!-- Dark left half (traveled, starfield) grows from 0 to 100% -->
          <div id="boot-bar-fill" class="absolute inset-y-0 left-0 h-full w-0 rounded-l-full bg-[#05070d] transition-[width] duration-200 ease-linear" style="width:0%"></div>
          <!-- Thin white divider line at the 50% midpoint -->
          <div id="boot-bar-line" class="absolute top-0 bottom-0 left-1/2 w-px bg-white/40"></div>
        </div>
        <!-- Rocket: moves left (0%) → right (100%) inside the bar track -->
        <div id="boot-rocket" class="absolute top-1/2 -translate-y-1/2 left-0 transition-[left] duration-200 ease-linear" style="left:0%">
          <svg viewBox="0 0 96 48" class="w-16 h-8 md:w-18 md:h-9 drop-shadow-[0_0_14px_rgba(135,243,255,0.75)]" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- exhaust flame (left side, trailing) -->
            <path d="M6 18 L0 24 L6 30 Z" fill="#8cf0ff" opacity="0.9"/>
            <path d="M10 20 L4 24 L10 28 Z" fill="#fff" opacity="0.75"/>
            <!-- fuselage -->
            <path d="M32 4 L12 16 Q4 24 12 32 L32 40 Q40 44 48 40 L68 32 Q76 24 68 16 Z" fill="#0a0303" stroke="#8cf0ff" stroke-width="1.2"/>
            <!-- window -->
            <circle cx="48" cy="20" r="3.5" fill="#8cf0ff" opacity="0.8"/>
            <circle cx="48" cy="20" r="2" fill="#0a0303"/>
            <!-- fins -->
            <path d="M12 32 L0 40 L12 36 Z" fill="#0a0303" stroke="#8cf0ff" stroke-width="0.8"/>
            <path d="M68 32 L80 40 L68 36 Z" fill="#0a0303" stroke="#8cf0ff" stroke-width="0.8"/>
          </svg>
        </div>
      </div>

      <div class="text-center">
        <p id="boot-status-primary" class="font-mono text-[11px] uppercase tracking-[0.25em] text-cyan-300 drop-shadow-[0_0_6px_theme('colors.cyan.400')]">
          HYPERION DRIVE ACTIVE
        </p>
        <p id="boot-status-secondary" class="font-mono text-[10px] tracking-[0.2em] mt-1 text-cyan-400/80 drop-shadow-[0_0_4px_theme('colors.cyan.400')]">
          ASCENT … 0%
        </p>
      </div>
    </div>
    <button id="boot-retry" hidden class="absolute bottom-16 text-sm text-cyan-200 border border-cyan-400/40 rounded px-4 py-2">Reload scene</button>
  </div>

  <SpaceCanvas client:only="react" />

  <script is:inline>
(function () {
  'use strict';

  var WRAP = document.getElementById('boot-canvas-wrap');
  var CANVAS = document.getElementById('boot-canvas');
  var CTX = CANVAS.getContext('2d');
  var ROCKET = document.getElementById('boot-rocket');
  var BAR_FILL = document.getElementById('boot-bar-fill');
  var BAR_LINE = document.getElementById('boot-bar-line');
  var STATUS_SEC = document.getElementById('boot-status-secondary');
  var ROOT = document.getElementById('boot-hud');
  var RETRY = document.getElementById('boot-retry');
  var finished = false;
  var rafId = 0;
  var previousOverflow = document.documentElement.style.overflow;
  document.documentElement.style.overflow = 'hidden';
  window.scrollTo(0, 0);
  RETRY.addEventListener('click', function () { window.location.reload(); });

  var W = 0, H = 0, DPR = Math.min(window.devicePixelRatio || 1, 2);
  var STATE = {
    speed: 1,
    t: 0,
    gaugeT: 0,
  };

  var COLORS = {
    bg: '#05070d',
    cyan: 'rgba(135,243,255,1)',
    dimCyan: 'rgba(135,243,255,0.35)',
    warm: 'rgba(120,220,255,0.9)',
    grid: 'rgba(135,243,255,0.05)',
  };

  function hexToRgb(hex) {
    var m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return m ? { r: parseInt(m[1], 16), g: parseInt(m[2], 16), b: parseInt(m[3], 16) }
      : { r: 0, g: 0, b: 0 };
  }
  function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
  function rand(min, max) { return min + Math.random() * (max - min); }

  // 3 depth layers of stars, accelerating as the gauge climbs.
  var STARS = { near: [], mid: [], far: [], all: [] };
  function initStars() {
    STARS.near = []; STARS.mid = []; STARS.far = []; STARS.all = [];
    var layers = [
      { depth: 0.18, count: 70, speed: 2.4, size: [0.7, 1.8] },
      { depth: 0.42, count: 120, speed: 1.2, size: [0.4, 1.1] },
      { depth: 0.72, count: 160, speed: 0.6, size: [0.3, 0.7] },
    ];
    layers.forEach(function (layer) {
      for (var i = 0; i < layer.count; i++) {
        var s = {
          z: rand(layer.depth, layer.depth + 0.22),
          x: rand(-1, 1),
          y: rand(-1, 1),
          baseSpeed: rand(0.25, 1) * layer.speed,
          size: rand(layer.size[0], layer.size[1]),
          phase: rand(0, Math.PI * 2),
          tail: [],
        };
        STARS[layer.hue || 'far'].push(s);
        STARS.all.push(s);
      }
    });
    // (hue buckets unused in this simpler draw route — kept for parity)
  }

  function resize() {
    var rect = WRAP.getBoundingClientRect();
    W = Math.max(1, Math.floor(rect.width));
    H = Math.max(1, Math.floor(rect.height));
    CANVAS.width = Math.floor(W * DPR);
    CANVAS.height = Math.floor(H * DPR);
    CANVAS.style.width = W + 'px';
    CANVAS.style.height = H + 'px';
    CTX.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  function drawBackground(colors, t) {
    CTX.fillStyle = colors.bg;
    CTX.fillRect(0, 0, W, H);

    CTX.save();
    CTX.translate(W / 2, H / 2);
    var gridScale = 0.5 + 0.5 * STATE.speed;
    var gridAlpha = 0.05 + 0.04 * STATE.speed;
    CTX.strokeStyle = hexToRgba(colors.cyan, gridAlpha);
    CTX.lineWidth = 1;
    CTX.setLineDash([2, 8]);
    for (var g = -20; g <= 20; g++) {
      var yy = g * 40 * gridScale;
      CTX.beginPath(); CTX.moveTo(-W, yy); CTX.lineTo(W, yy); CTX.stroke();
    }
    for (var gg = -20; gg <= 20; gg++) {
      var xx = gg * 40 * gridScale;
      CTX.beginPath(); CTX.moveTo(xx, -H); CTX.lineTo(xx, H); CTX.stroke();
    }
    CTX.setLineDash([]);
    CTX.restore();
  }

  function hexToRgba(hex, alpha) {
    var c = hexToRgb(hex.replace('rgb', '').replace(/\(.*/, ''));
    if (!c.r && !c.g && !c.b) {
      var m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
      if (m) { c = { r: parseInt(m[1], 16), g: parseInt(m[2], 16), b: parseInt(m[3], 16) }; }
      else { return 'rgba(135,243,255,' + alpha + ')'; }
    }
    return 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + alpha + ')';
  }

  function drawStars(state, t, colors) {
    var cx = W / 2, cy = H / 2;
    // Left half = dark traveled region; clip stars to that side so they only
    // appear in the dark portion trailing behind the rocket.
    var leftHalf = W / 2;
    var accel = 1 + 0.8 * state.speed;
    var speedMul = Math.min(20, 1 + 19 * state.speed);

    STARS.all.forEach(function (s) {
      var sp = s.baseSpeed * accel * speedMul * (0.7 + 0.5 * Math.sin(state.t * 0.6 + s.phase));
      s.z += sp * 0.008;
      if (s.z > 1.2) {
        s.z = 0.02;
        s.x = rand(-1, 1);
        s.y = rand(-1, 1);
        s.tail = [];
      }
      var perspective = 1 / Math.max(0.05, s.z);
      var px = cx + s.x * perspective * (W * 0.5);
      var py = cy + s.y * perspective * (H * 0.5);
      // Only draw stars in the dark (left) half — white right half stays clean.
      if (px > leftHalf - 1) return;
      var size = s.size * (0.5 + 0.5 * perspective);

      var tailLen = Math.min(22, Math.floor(6 + 16 * state.speed * (state.speed > 3 ? 2.6 : 1)));
      s.tail.push({ x: px, y: py, life: 1 });
      if (s.tail.length > tailLen) s.tail.shift();
      s.tail.forEach(function (p, i) { p.life -= 1 / tailLen; });
      s.tail = s.tail.filter(function (p) { return p.life > 0; });

      var alpha = clamp((1 - s.z) * 0.95, 0.2, 0.98);
      var col = colors.cyan;
      CTX.beginPath();
      CTX.arc(px, py, Math.max(0.3, size), 0, Math.PI * 2);
      CTX.fillStyle = col.replace('1)', alpha + ')');
      CTX.fill();

      if (s.tail.length > 1) {
        CTX.save();
        CTX.globalAlpha = alpha * 0.55 * (state.speed > 3 ? 0.95 : 0.45);
        CTX.strokeStyle = col;
        CTX.lineWidth = Math.max(0.5, size * 0.6);
        CTX.beginPath();
        CTX.moveTo(s.tail[0].x, s.tail[0].y);
        for (var i = 1; i < s.tail.length; i++) CTX.lineTo(s.tail[i].x, s.tail[i].y);
        CTX.lineTo(px, py);
        CTX.stroke();
        CTX.restore();
      }
    });
  }

  function updateGauge() {
    var target = Number(ROOT.dataset.progress || 0);
    STATE.gaugeT = Math.max(STATE.gaugeT, target);
    var rocketPct = Math.min(100, Math.max(0, STATE.gaugeT * 100));
    // Dark fill grows across the full width (0% → 100%), covering the white
    // half as the rocket crosses the midpoint line.
    var fillW = Math.min(100, STATE.gaugeT * 100);
    BAR_FILL.style.width = fillW + '%';
    // Rocket travels inside the full bar from left (0%) to right (100%).
    ROCKET.style.left = rocketPct + '%';
    // Midpoint divider line stays fixed at 50% of the bar.
    BAR_LINE.style.left = '50%';
    // Stars accelerate as the rocket progresses.
    STATE.speed = 0.4 + 3.4 * STATE.gaugeT;
    STATUS_SEC.textContent = 'ASCENT … ' + Math.floor(rocketPct) + '%';
    if (STATE.gaugeT >= 1) completeBoot();
    if (ROOT.dataset.stage === 'error') {
      RETRY.hidden = false;
      RETRY.title = ROOT.dataset.error;
      ROOT.setAttribute('aria-busy', 'false');
    }
    if (ROOT.dataset.stage === 'ready') completeBoot();
  }

  function completeBoot() {
    if (finished) return;
    finished = true;
    ROOT.setAttribute('aria-busy', 'false');
    ROOT.style.transition = 'opacity 0.5s ease';
    ROOT.style.opacity = '0';
    cancelAnimationFrame(rafId);
    window.removeEventListener('resize', resize);
    window.removeEventListener('portfolio:boot', updateGauge);
    setTimeout(function () {
      ROOT.style.display = 'none';
      document.documentElement.style.overflow = previousOverflow;
      window.scrollTo(0, 0);
      window.dispatchEvent(new Event('portfolio:revealed'));
    }, 500);
  }

  function loop(t) {
    if (finished) return;
    STATE.t = t / 1000;
    var colors = COLORS;
    drawBackground(colors, STATE.t);
    drawStars({ speed: STATE.speed, t: STATE.t }, STATE.t, colors);
    updateGauge();
    if (!finished) rafId = requestAnimationFrame(loop);
  }

  function init() {
    initStars();
    resize();
    window.addEventListener('resize', resize);
    window.addEventListener('portfolio:boot', updateGauge);
    updateGauge();
    if (!finished) rafId = requestAnimationFrame(loop);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
  </script>

  <style is:global>
    #boot-hud {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</Layout>
