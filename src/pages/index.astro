---
import SpaceCanvas from '../components/SpaceCanvas';
import Layout from '../layouts/Layout.astro';
---

<Layout title="3D Portfolio">
  <!-- Loading HUD: shown until the R3F scene is mounted and first render lands. -->
  <div id="boot-hud" data-stage="loading" data-progress="0" aria-busy="true" class="fixed inset-0 z-[9999] flex items-center justify-center bg-black overflow-hidden">
    <div id="boot-canvas-wrap" class="absolute inset-0">
      <canvas id="boot-canvas" class="absolute inset-0 w-full h-full"></canvas>
    </div>

    <div class="relative z-10 flex flex-col items-center gap-8 select-none">
      <!-- Vertical rocket speed bar -->
      <div class="relative w-[64px] h-[280px] md:w-[72px] md:h-[320px] flex flex-col items-center">
        <div class="relative w-full h-full rounded-full overflow-hidden border border-white/10 shadow-[0_0_30px_8px_rgba(135,243,255,0.12)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-white/90"></div>
          <div id="boot-bar-fill" class="absolute bottom-0 left-0 right-0 h-0 rounded-full bg-[#05070d] transition-[height] duration-200 ease-linear" style="height:0%"></div>
          <div id="boot-bar-line" class="absolute left-0 right-0 h-px bg-white/40" style="bottom:50%"></div>
        </div>
        <div id="boot-rocket" class="absolute left-1/2 -translate-x-1/2 bottom-0 transition-[bottom] duration-200 ease-linear" style="bottom:0%">
          <svg viewBox="0 0 48 96" class="w-7 h-14 md:w-8 md:h-16 drop-shadow-[0_0_10px_rgba(135,243,255,0.6)]" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 90 L24 96 L28 90 Z" fill="#8cf0ff" opacity="0.9"/>
            <path d="M21 86 L24 92 L27 86 Z" fill="#fff" opacity="0.7"/>
            <path d="M24 4 L16 40 L16 72 Q16 84 24 88 Q32 84 32 72 L32 4 Z" fill="#0a0303" stroke="#8cf0ff" stroke-width="1.2"/>
            <circle cx="24" cy="28" r="3.5" fill="#8cf0ff" opacity="0.8"/>
            <circle cx="24" cy="28" r="2" fill="#0a0303"/>
            <path d="M16 72 L10 84 L16 80 Z" fill="#0a0303" stroke="#8cf0ff" stroke-width="0.8"/>
            <path d="M32 72 L38 84 L32 80 Z" fill="#0a0303" stroke="#8cf0ff" stroke-width="0.8"/>
          </svg>
        </div>
      </div>

      <div class="text-center">
        <p id="boot-status-primary" class="font-mono text-[11px] uppercase tracking-[0.25em] text-cyan-300 drop-shadow-[0_0_6px_theme('colors.cyan.400')]">
          HYPERION DRIVE ACTIVE
        </p>
        <p id="boot-status-secondary" class="font-mono text-[10px] tracking-[0.2em] mt-1 text-cyan-400/80 drop-shadow-[0_0_4px_theme('colors.cyan.400')]">
          ASCENT … 0%
        </p>
      </div>
    </div>
    <button id="boot-retry" hidden class="absolute bottom-16 text-sm text-cyan-200 border border-cyan-400/40 rounded px-4 py-2">Reload scene</button>
  </div>

  <SpaceCanvas client:only="react" />
</Layout>

<script is:inline>
(function () {
  'use strict';

  var WRAP = document.getElementById('boot-canvas-wrap');
  var CANVAS = document.getElementById('boot-canvas');
  var CTX = CANVAS.getContext('2d');
  var ROCKET = document.getElementById('boot-rocket');
  var BAR_FILL = document.getElementById('boot-bar-fill');
  var BAR_LINE = document.getElementById('boot-bar-line');
  var STATUS_SEC = document.getElementById('boot-status-secondary');
  var ROOT = document.getElementById('boot-hud');
  var RETRY = document.getElementById('boot-retry');
  var finished = false;
  var rafId = 0;
  var previousOverflow = document.documentElement.style.overflow;
  document.documentElement.style.overflow = 'hidden';
  window.scrollTo(0, 0);
  RETRY.addEventListener('click', function () { window.location.reload(); });

  var W = 0, H = 0, DPR = Math.min(window.devicePixelRatio || 1, 2);
  var STATE = {
    speed: 1,         // multiplier — ramps as gauge fills, stars accelerate
    px: 50, py: 50,
    t: 0,
    gaugeT: 0,
  };

  // Color tokens
  var COLORS = {
    bg: '#05070d',
    cyan: 'rgba(135,243,255,1)',
    dimCyan: 'rgba(135,243,255,0.35)',
    warm: 'rgba(120,220,255,0.9)',
    grid: 'rgba(135,243,255,0.05)',
  };

  function hexToRgb(hex) {
    var m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return m ? {
      r: parseInt(m[1], 16), g: parseInt(m[2], 16), b: parseInt(m[3], 16)
    } : { r: 0, g: 0, b: 0 };
  }

  function lerp(a, b, t) { return a + (b - a) * t; }
  function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
  function rand(min, max) { return min + Math.random() * (max - min); }

  // Starfield: 3 depth layers with perspective anchor, accelerating over time.
  var STARS = { near: [], mid: [], far: [], all: [] };
  function initStars() {
    STARS.near = []; STARS.mid = []; STARS.far = []; STARS.all = [];
    var layers = [
      { depth: 0.18, count: 70, speed: 2.4, size: [0.6, 1.6], hue: 'near' },
      { depth: 0.42, count: 120, speed: 1.2, size: [0.4, 1.0], hue: 'mid' },
      { depth: 0.72, count: 160, speed: 0.6, size: [0.3, 0.7], hue: 'far' },
    ];
    layers.forEach(function (layer) {
      for (var i = 0; i < layer.count; i++) {
        var s = {
          layer: layer.hue,
          z: rand(layer.depth, layer.depth + 0.22),
          x: rand(-1, 1),
          y: rand(-1, 1),
          baseSpeed: rand(0.25, 1) * layer.speed,
          size: rand(layer.size[0], layer.size[1]),
          phase: rand(0, Math.PI * 2),
          tail: [],
        };
        STARS[layer.hue].push(s);
        STARS.all.push(s);
      }
    });
  }

  function resize() {
    var rect = WRAP.getBoundingClientRect();
    W = Math.max(1, Math.floor(rect.width));
    H = Math.max(1, Math.floor(rect.height));
    CANVAS.width = Math.floor(W * DPR);
    CANVAS.height = Math.floor(H * DPR);
    CANVAS.style.width = W + 'px';
    CANVAS.style.height = H + 'px';
    CTX.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  function drawBackground(colors, t) {
    // Very dark base
    CTX.fillStyle = colors.bg;
    CTX.fillRect(0, 0, W, H);

    // Subtle perspective grid (parallax)
    CTX.save();
    CTX.translate(W / 2, H / 2);
    var gridScale = 0.5 + 0.5 * STATE.speed;
    var gridAlpha = 0.05 + 0.04 * STATE.speed;
    CTX.strokeStyle = hexToRgba(colors.cyan, gridAlpha);
    CTX.lineWidth = 1;
    CTX.setLineDash([2, 8]);
    for (var g = -20; g <= 20; g++) {
      var yy = g * 40 * gridScale;
      CTX.beginPath();
      CTX.moveTo(-W, yy);
      CTX.lineTo(W, yy);
      CTX.stroke();
    }
    for (var gg = -20; gg <= 20; gg++) {
      var xx = gg * 40 * gridScale;
      CTX.beginPath();
      CTX.moveTo(xx, -H);
      CTX.lineTo(xx, H);
      CTX.stroke();
    }
    CTX.setLineDash([]);
    CTX.restore();
  }

  function hexToRgba(hex, alpha) {
    var c = hexToRgb(hex.replace('rgb', '').replace(/\(.*/, ''));
    if (!c.r && !c.g && !c.b) {
      // fallback: if hex passed directly
      var m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
      if (m) {
        c = { r: parseInt(m[1], 16), g: parseInt(m[2], 16), b: parseInt(m[3], 16) };
      } else {
        return 'rgba(135,243,255,' + alpha + ')';
      }
    }
    return 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + alpha + ')';
  }

  function drawStars(state, t, colors) {
    var cx = W / 2, cy = H / 2;
    var accel = 1 + 0.8 * state.speed;
    var speedMul = Math.min(18, 1 + 17 * state.speed);

    STARS.all.forEach(function (s) {
      var sp = s.baseSpeed * accel * speedMul * (0.7 + 0.5 * Math.sin(state.t * 0.6 + s.phase));
      s.z += sp * 0.006;
      if (s.z > 1.2) {
        s.z = 0.02;
        s.x = rand(-1, 1);
        s.y = rand(-1, 1);
        s.tail = [];
      }
      var perspective = 1 / Math.max(0.05, s.z);
      var px = cx + s.x * perspective * (W * 0.5);
      var py = cy + s.y * perspective * (H * 0.5);
      // Clip stars to the lower half (the dark traveled portion of the capsule)
      if (py < cy - 2) return;
      var size = s.size * (0.5 + 0.5 * perspective);

      var tailLen = Math.min(20, Math.floor(6 + 14 * state.speed * (state.speed > 3 ? 2.4 : 1)));
      s.tail.push({ x: px, y: py, life: 1 });
      if (s.tail.length > tailLen) s.tail.shift();
      s.tail.forEach(function (p, i) { p.life -= 1 / tailLen; });
      s.tail = s.tail.filter(function (p) { return p.life > 0; });

      var alpha = clamp((1 - s.z) * 0.95, 0.2, 0.98);
      var col = colors.cyan;
      CTX.beginPath();
      CTX.arc(px, py, Math.max(0.3, size), 0, Math.PI * 2);
      CTX.fillStyle = col.replace('1)', alpha + ')');
      CTX.fill();

      if (s.tail.length > 1) {
        CTX.save();
        CTX.globalAlpha = alpha * 0.55 * (state.speed > 3 ? 0.95 : 0.45);
        CTX.strokeStyle = col;
        CTX.lineWidth = Math.max(0.5, size * 0.6);
        CTX.beginPath();
        CTX.moveTo(s.tail[0].x, s.tail[0].y);
        for (var i = 1; i < s.tail.length; i++) CTX.lineTo(s.tail[i].x, s.tail[i].y);
        CTX.lineTo(px, py);
        CTX.stroke();
        CTX.restore();
      }
    });
  }

  function updateGauge() {
    var target = Number(ROOT.dataset.progress || 0);
    STATE.gaugeT = Math.max(STATE.gaugeT, target);
    var pct = STATE.gaugeT * 100;
    // Dark fill grows from bottom (0%) up to the midpoint (50%), then crosses
    // into the white half — the rocket keeps climbing past the line to 100%.
    var fillPct = Math.min(100, pct * 1.2);
    BAR_FILL.style.height = fillPct + '%';
    // Rocket position: 0% at bottom, 100% at top of the bar.
    var rocketPct = Math.min(100, Math.max(0, pct * 100));
    ROCKET.style.bottom = rocketPct + '%';
    // White line stays at the 50% mark (the capsule midpoint).
    BAR_LINE.style.bottom = '50%';
    // Speed ramps as progress climbs.
    STATE.speed = 0.4 + 3.2 * STATE.gaugeT;
    STATUS_SEC.textContent = 'ASCENT … ' + Math.floor(rocketPct) + '%';
    if (ROOT.dataset.stage === 'error') {
      RETRY.hidden = false;
      RETRY.title = ROOT.dataset.error;
      ROOT.setAttribute('aria-busy', 'false');
    }
    if (ROOT.dataset.stage === 'ready') completeBoot();
  }

  function completeBoot() {
    if (finished) return;
    finished = true;
    ROOT.setAttribute('aria-busy', 'false');
    ROOT.style.transition = 'opacity 0.5s ease';
    ROOT.style.opacity = '0';
    cancelAnimationFrame(rafId);
    window.removeEventListener('resize', resize);
    window.removeEventListener('portfolio:boot', updateGauge);
    setTimeout(function () {
      ROOT.style.display = 'none';
      document.documentElement.style.overflow = previousOverflow;
      window.scrollTo(0, 0);
      window.dispatchEvent(new Event('portfolio:revealed'));
    }, 500);
  }

  function loop(t) {
    if (finished) return;
    STATE.t = t / 1000;

    var colors = COLORS;
    drawBackground(colors, STATE.t);
    drawStars({ speed: STATE.speed, t: STATE.t }, STATE.t, colors);
    updateGauge();

    if (!finished) rafId = requestAnimationFrame(loop);
  }

  function init() {
    initStars();
    resize();
    window.addEventListener('resize', resize);
    window.addEventListener('portfolio:boot', updateGauge);
    updateGauge(); // also consume readiness if hydration finished first
    if (!finished) rafId = requestAnimationFrame(loop);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<style is:global>
  #boot-hud {
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
