---
import SpaceCanvas from '../components/SpaceCanvas';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gabriel Mandrake | Full Stack Developer">
  <!-- Loading HUD: shown until the R3F scene is mounted and first render lands. -->
  <div id="boot-hud" class="fixed inset-0 z-[9999] flex items-center justify-center bg-black overflow-hidden">
    <div id="boot-canvas-wrap" class="absolute inset-0">
      <canvas id="boot-canvas" class="absolute inset-0 w-full h-full"></canvas>
    </div>

    <div class="relative z-10 flex flex-col items-center gap-6 select-none">
      <!-- Engineering override toggle -->
      <button id="boot-toggle" type="button" aria-label="Toggle engineering drive override" class="absolute top-6 right-6 group">
        <span class="block text-[10px] tracking-[0.3em] uppercase opacity-60 group-hover:opacity-100 transition-opacity">ENG OVERRIDE</span>
        <span id="boot-toggle-led" class="block h-2 w-2 rounded-full bg-cyan-400 shadow-[0_0_8px_2px_theme('colors.cyan.400')] transition-all duration-200"></span>
      </button>

      <!-- Central HUD -->
      <div id="boot-hud-core" class="relative w-[30vmin] h-[30vmin] max-w-[340px] max-h-[340px]">
        <!-- Three nested rings -->
        <svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- Outer dashed ring: clockwise -->
          <circle cx="50" cy="50" r="47" fill="none"
                  stroke="currentColor" stroke-width="0.5"
                  stroke-dasharray="2 4" class="ring-ring" />
          <!-- Asymmetrical semi-open thick ring: counter-clockwise -->
          <path class="ring-arc" d="M 50 10 A 40 40 0 1 1 10 50 L 10 50 A 40 40 0 0 1 50 10 Z" />
          <!-- Continuous radar sweep -->
          <g class="radar-group">
            <line x1="50" y1="50" x2="50" y2="4" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" opacity="0.9" />
            <path d="M 50 50 L 50 4 A 46 46 0 0 1 87.8 18.7 Z" fill="currentColor" opacity="0.12" />
          </g>
        </svg>

        <!-- Central neon core that tracks mouse with delay -->
        <div id="boot-core" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3 h-3 rounded-full pointer-events-none" style="box-shadow: 0 0 14px 4px currentColor;"></div>
      </div>

      <!-- Telemetry text logs -->
      <div class="fixed left-1/2 -translate-x-1/2 bottom-10 w-[80%] max-w-[520px] text-center">
        <p id="boot-status-primary" class="font-mono text-[11px] uppercase tracking-[0.25em] text-cyan-300 drop-shadow-[0_0_6px_theme('colors.cyan.400')]">
          HYPERION DRIVE ACTIVE
        </p>
        <p id="boot-status-secondary" class="font-mono text-[10px] tracking-[0.2em] mt-1 text-green-400/90 drop-shadow-[0_0_4px_theme('colors.green.400')]">
          INITIALIZING QUANTUM TRANSIT … 0%
        </p>
        <div class="mt-2 h-0.5 w-full max-w-[240px] mx-auto bg-white/8 rounded-full overflow-hidden">
          <div id="boot-bar" class="h-full w-0 rounded-full transition-[width,background] duration-300"></div>
        </div>
        <pre id="boot-log" class="mt-4 font-mono text-[9px] leading-relaxed text-cyan-200/70 text-align-center whitespace-pre-wrap drop-shadow-[0_0_3px_theme('colors.cyan.300')]"></pre>
      </div>
    </div>
  </div>

  <SpaceCanvas client:only="react" />

  <div class="fixed inset-0 pointer-events-none z-20">
    <div class="w-full h-screen flex flex-col justify-between p-6 md:p-12">
      <div class="grid grid-cols-12 gap-6 md:gap-12">
        <div class="col-span-4 md:col-span-3 border-l border-white/10 pl-4 md:pl-6">
          <p class="font-syne font-bold text-[10px] md:text-xs uppercase tracking-[0.2em] text-cyan-400/60 mb-3">
            Portfolio
          </p>
          <h1 class="font-syne font-extrabold text-2xl md:text-4xl lg:text-5xl uppercase tracking-tight leading-[0.9] text-white">
            Gabriel<br />Mandrake
          </h1>
        </div>

        <div class="col-span-4 md:col-span-6 flex items-center justify-center">
        </div>

        <div class="col-span-4 md:col-span-3 border-r border-white/10 pr-4 md:pr-6 text-right">
          <p class="font-syne font-bold text-[10px] md:text-xs uppercase tracking-[0.2em] text-cyan-400/60 mb-3">
            Status
          </p>
          <p class="font-inter font-medium text-xs md:text-sm text-white/90">
            Available for work
          </p>
          <p class="font-inter font-light text-[10px] md:text-xs text-gray-500 mt-1">
            2024 — Present
          </p>
        </div>
      </div>

      <div class="grid grid-cols-12 gap-6 md:gap-12 mt-auto">
        <div class="col-span-4 md:col-span-3 border-l border-white/10 pl-4 md:pl-6">
          <p class="font-syne font-bold text-[10px] md:text-xs uppercase tracking-[0.2em] text-cyan-400/60 mb-3">
            Expertise
          </p>
          <div class="space-y-0.5">
            <p class="font-inter font-light text-[10px] md:text-xs text-gray-400">React Three Fiber</p>
            <p class="font-inter font-light text-[10px] md:text-xs text-gray-400">Three.js</p>
            <p class="font-inter font-light text-[10px] md:text-xs text-gray-400">Astro</p>
            <p class="font-inter font-light text-[10px] md:text-xs text-gray-400">GSAP</p>
          </div>
        </div>

        <div class="col-span-4 md:col-span-6 flex items-center justify-center">
        </div>

        <div class="col-span-4 md:col-span-3 border-r border-white/10 pr-4 md:pr-6 text-right">
          <p class="font-syne font-bold text-[10px] md:text-xs uppercase tracking-[0.2em] text-cyan-400/60 mb-3">
            Location
          </p>
          <p class="font-inter font-medium text-xs md:text-sm text-white/90">
            Worldwide
          </p>
          <p class="font-inter font-light text-[10px] md:text-xs text-gray-500 mt-1">
            Remote Available
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
(function () {
  'use strict';

  var WRAP = document.getElementById('boot-canvas-wrap');
  var CANVAS = document.getElementById('boot-canvas');
  var CTX = CANVAS.getContext('2d');
  var CORE = document.getElementById('boot-core');
  var LOG = document.getElementById('boot-log');
  var BAR = document.getElementById('boot-bar');
  var STATUS_SEC = document.getElementById('boot-status-secondary');
  var TOGGLE = document.getElementById('boot-toggle');
  var TOGGLE_LED = document.getElementById('boot-toggle-led');
  var ROOT = document.getElementById('boot-hud');

  var W = 0, H = 0, DPR = Math.min(window.devicePixelRatio || 1, 2);
  var STATE = {
    mode: 'cyan',     // 'cyan' | 'red'
    speed: 1,         // multiplier
    engaged: false,
    px: 50, py: 50,   // raw mouse (percent)
    tx: 50, ty: 50,   // smoothed target (percent)
    t: 0,
    logLines: [],
    gaugeT: 0,
  };

  // Color tokens
  var COLORS = {
    cyan: {
      bg: '#05070d',
      cyan: 'rgba(135,243,255,1)',
      dimCyan: 'rgba(135,243,255,0.35)',
      core: '#7fffed',
      warm: 'rgba(120,220,255,0.9)',
      grid: 'rgba(135,243,255,0.05)',
      log: '#8cf0ff',
    },
    red: {
      bg: '#0a0303',
      cyan: 'rgba(255,90,90,1)',
      dimCyan: 'rgba(255,90,90,0.35)',
      core: '#ff5a5a',
      warm: 'rgba(255,140,140,0.9)',
      grid: 'rgba(255,90,90,0.05)',
      log: '#ffb0b0',
    }
  };

  function hexToRgb(hex) {
    var m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return m ? {
      r: parseInt(m[1], 16), g: parseInt(m[2], 16), b: parseInt(m[3], 16)
    } : { r: 0, g: 0, b: 0 };
  }

  function lerp(a, b, t) { return a + (b - a) * t; }
  function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
  function rand(min, max) { return min + Math.random() * (max - min); }

  function pick(c) {
    return c === 'cyan' ? COLORS.cyan : COLORS.red;
  }

  // Starfield: 3 depth layers with perspective anchor, accelerating over time.
  var STARS = { near: [], mid: [], far: [], all: [] };
  function initStars() {
    STARS.near = []; STARS.mid = []; STARS.far = []; STARS.all = [];
    var layers = [
      { depth: 0.18, count: 70, speed: 2.4, size: [0.6, 1.6], hue: 'near' },
      { depth: 0.42, count: 120, speed: 1.2, size: [0.4, 1.0], hue: 'mid' },
      { depth: 0.72, count: 160, speed: 0.6, size: [0.3, 0.7], hue: 'far' },
    ];
    layers.forEach(function (layer) {
      for (var i = 0; i < layer.count; i++) {
        var s = {
          layer: layer.hue,
          z: rand(layer.depth, layer.depth + 0.22),
          x: rand(-1, 1),
          y: rand(-1, 1),
          baseSpeed: rand(0.25, 1) * layer.speed,
          size: rand(layer.size[0], layer.size[1]),
          phase: rand(0, Math.PI * 2),
          tail: [],
        };
        STARS[layer.hue].push(s);
        STARS.all.push(s);
      }
    });
  }

  function resize() {
    var rect = WRAP.getBoundingClientRect();
    W = Math.max(1, Math.floor(rect.width));
    H = Math.max(1, Math.floor(rect.height));
    CANVAS.width = Math.floor(W * DPR);
    CANVAS.height = Math.floor(H * DPR);
    CANVAS.style.width = W + 'px';
    CANVAS.style.height = H + 'px';
    CTX.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  function drawBackground(colors, t) {
    // Very dark base
    CTX.fillStyle = colors.bg;
    CTX.fillRect(0, 0, W, H);

    // Subtle perspective grid (parallax)
    CTX.save();
    CTX.translate(W / 2, H / 2);
    var gridScale = 0.5 + 0.5 * STATE.speed;
    var gridAlpha = 0.05 + 0.04 * STATE.speed;
    CTX.strokeStyle = hexToRgba(colors.cyan, gridAlpha);
    CTX.lineWidth = 1;
    CTX.setLineDash([2, 8]);
    for (var g = -20; g <= 20; g++) {
      var yy = g * 40 * gridScale;
      CTX.beginPath();
      CTX.moveTo(-W, yy);
      CTX.lineTo(W, yy);
      CTX.stroke();
    }
    for (var gg = -20; gg <= 20; gg++) {
      var xx = gg * 40 * gridScale;
      CTX.beginPath();
      CTX.moveTo(xx, -H);
      CTX.lineTo(xx, H);
      CTX.stroke();
    }
    CTX.setLineDash([]);
    CTX.restore();
  }

  function hexToRgba(hex, alpha) {
    var c = hexToRgb(hex.replace('rgb', '').replace(/\(.*/, ''));
    if (!c.r && !c.g && !c.b) {
      // fallback: if hex passed directly
      var m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
      if (m) {
        c = { r: parseInt(m[1], 16), g: parseInt(m[2], 16), b: parseInt(m[3], 16) };
      } else {
        return 'rgba(135,243,255,' + alpha + ')';
      }
    }
    return 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + alpha + ')';
  }

  function drawStars(state, t, colors) {
    var cx = W / 2, cy = H / 2;
    var accel = 1 + 0.6 * state.speed;
    var warp = state.engaged ? Math.min(8, 1 + 7 * state.speed) : 1;

    STARS.all.forEach(function (s) {
      var sp = s.baseSpeed * accel * warp * (0.8 + 0.4 * Math.sin(state.t * 0.5 + s.phase));
      s.z += sp * 0.004;
      if (s.z > 1.2) {
        s.z = 0.02;
        s.x = rand(-1, 1);
        s.y = rand(-1, 1);
        s.tail = [];
      }
      var perspective = 1 / Math.max(0.05, s.z);
      var px = cx + s.x * perspective * (W * 0.5);
      var py = cy + s.y * perspective * (H * 0.5);
      var size = s.size * (0.5 + 0.5 * perspective);

      // Tail (velocity stretch)
      var tailLen = Math.min(18, Math.floor(6 + 12 * state.speed * (state.engaged ? 2.2 : 1)));
      s.tail.push({ x: px, y: py, life: 1 });
      if (s.tail.length > tailLen) s.tail.shift();
      s.tail.forEach(function (p, i) {
        p.life -= 1 / tailLen;
      });
      s.tail = s.tail.filter(function (p) { return p.life > 0; });

      var alpha = clamp((1 - s.z) * 0.9, 0.15, 0.95);
      var col = state.engaged ? colors.cyan : colors.dimCyan;
      CTX.beginPath();
      CTX.arc(px, py, Math.max(0.3, size), 0, Math.PI * 2);
      CTX.fillStyle = col.replace('1)', alpha + ')');
      CTX.fill();

      // Draw tail as fading line
      if (s.tail.length > 1) {
        CTX.save();
        CTX.globalAlpha = alpha * 0.5 * (state.engaged ? 0.9 : 0.4);
        CTX.strokeStyle = col;
        CTX.lineWidth = Math.max(0.5, size * 0.6);
        CTX.beginPath();
        CTX.moveTo(s.tail[0].x, s.tail[0].y);
        for (var i = 1; i < s.tail.length; i++) {
          CTX.lineTo(s.tail[i].x, s.tail[i].y);
        }
        CTX.lineTo(px, py);
        CTX.stroke();
        CTX.restore();
      }
    });
  }

  function drawHUD(colors, t) {
    var cx = W / 2, cy = H / 2;
    var size = Math.min(W, H) * 0.32;
    var r = size / 2;

    CTX.save();
    CTX.translate(cx, cy);

    // Outer dashed ring spinning clockwise
    CTX.save();
    CTX.rotate(t * 0.15);
    CTX.strokeStyle = colors.cyan;
    CTX.globalAlpha = 0.5 + 0.3 * Math.sin(t * 0.5);
    CTX.lineWidth = Math.max(1, r * 0.02);
    CTX.setLineDash([4, 6]);
    CTX.beginPath();
    CTX.arc(0, 0, r * 0.92, 0, Math.PI * 2);
    CTX.stroke();
    CTX.setLineDash([]);
    CTX.restore();

    // Asymmetrical semi-open thick ring spinning counter-clockwise
    // We'll draw a thick arc that covers most of the circle but leaves a gap,
    // plus a thinner fill to make it "semi-open" looking.
    CTX.save();
    CTX.rotate(-t * 0.22);
    var thickR = r * 0.78;
    var thickW = Math.max(3, r * 0.07);
    var startAngle = -Math.PI * 0.75;
    var endAngle = Math.PI * 0.75;
    CTX.beginPath();
    CTX.arc(0, 0, thickR, startAngle, endAngle);
    CTX.strokeStyle = colors.cyan;
    CTX.globalAlpha = 0.85;
    CTX.lineWidth = thickW;
    CTX.lineCap = 'round';
    CTX.stroke();

    // Inner glow for the arc
    CTX.globalAlpha = 0.25;
    CTX.beginPath();
    CTX.arc(0, 0, thickR, startAngle, endAngle);
    CTX.strokeStyle = colors.warm;
    CTX.lineWidth = thickW * 2.5;
    CTX.stroke();
    CTX.restore();

    // Continuous radar sweep (rotating line + arc)
    CTX.save();
    CTX.rotate(t * 0.6);
    // Sweep line
    CTX.beginPath();
    CTX.moveTo(0, 0);
    CTX.lineTo(0, -r * 0.95);
    CTX.strokeStyle = colors.cyan;
    CTX.globalAlpha = 0.9;
    CTX.lineWidth = Math.max(1, r * 0.015);
    CTX.lineCap = 'round';
    CTX.stroke();
    // Sweep arc (triangular wedge)
    CTX.beginPath();
    CTX.moveTo(0, 0);
    CTX.arc(0, 0, r * 0.95, -0.35, 0.35);
    CTX.closePath();
    CTX.fillStyle = colors.cyan;
    CTX.globalAlpha = 0.1;
    CTX.fill();
    CTX.restore();

    // Subtle center crosshair
    CTX.strokeStyle = colors.dimCyan;
    CTX.globalAlpha = 0.3;
    CTX.lineWidth = 0.5;
    CTX.beginPath();
    CTX.moveTo(-r * 0.15, 0); CTX.lineTo(r * 0.15, 0);
    CTX.moveTo(0, -r * 0.15); CTX.lineTo(0, r * 0.15);
    CTX.stroke();

    CTX.restore();
  }

  var diagVars = [
    { label: 'VTG', unit: 'm/s', fn: function () { return (Math.floor(1200 + 800 * Math.sin(STATE.t * 0.3) + rand(-15, 15))).toFixed(0); } },
    { label: 'MXG', unit: 'nodes', fn: function () { return Math.floor(1240 + 60 * Math.sin(STATE.t * 0.17 + 1) + rand(-8, 8)); } },
    { label: 'QTX', unit: '%', fn: function () { return (92 + 6 * Math.sin(STATE.t * 0.23 + 2) + rand(-1, 1)).toFixed(1); } },
    { label: 'PWR', unit: 'MW', fn: function () { return (41.2 + 2.1 * Math.sin(STATE.t * 0.19 + 3) + rand(-0.3, 0.3)).toFixed(1); } },
    { label: 'NAV', unit: 'lock', fn: function () { return (Math.random() > 0.15) ? 'STABLE' : 'ERR'; } },
    { label: 'DRV', unit: 'thr', fn: function () { return (78 + 12 * Math.sin(STATE.t * 0.13 + 4) + rand(-2, 2)).toFixed(0); } },
    { label: 'TMP', unit: 'K', fn: function () { return (290 + 8 * Math.sin(STATE.t * 0.27 + 5) + rand(-2, 2)).toFixed(0); } },
    { label: 'VCT', unit: 'kv', fn: function () { return (1420 + 220 * Math.sin(STATE.t * 0.31 + 6) + rand(-20, 20)).toFixed(0); } },
  ];

  function pushLog(colors) {
    var line = '';
    var parts = [];
    for (var i = 0; i < diagVars.length; i++) {
      var v = diagVars[i];
      var val = v.fn();
      parts.push(v.label + ': ' + val + ' ' + v.unit);
    }
    line = parts.join('   ·   ');
    STATE.logLines.push(line);
    if (STATE.logLines.length > 6) STATE.logLines.shift();
    LOG.textContent = STATE.logLines.join('\n');
  }

  function updateGauge(delta, colors) {
    STATE.gaugeT += delta * (0.04 + 0.06 * STATE.speed);
    var pct = clamp(STATE.gaugeT, 0, 1);
    var showPct = Math.floor(pct * 100);
    BAR.style.width = (pct * 100) + '%';
    if (STATE.mode === 'red') {
      BAR.style.background = '#ff5a5a';
    } else {
      BAR.style.background = '#8cf0ff';
    }
    STATUS_SEC.textContent = 'INITIALIZING QUANTUM TRANSIT \u00a0\u00a0' + showPct + '%';

    // Once full, "complete" by hiding the HUD after a short hold.
    if (pct >= 1) {
      completeBoot();
    }
  }

  function completeBoot() {
    if (document.getElementById('boot-hud').style.display === 'none') return;
    document.getElementById('boot-hud').style.transition = 'opacity 0.5s ease, visibility 0.5s ease';
    document.getElementById('boot-hud').style.opacity = '0';
    document.getElementById('boot-hud').style.visibility = 'hidden';
    // Also hide the text shell via the inline <style>
    var style = document.getElementById('boot-style');
    if (style) style.textContent += '\n#boot-hud { display: none !important; }';
  }

  // R3F scene ready signal: the canvas becomes visible/non-empty
  var R3F_READY_CHECK_INTERVAL = null;
  function watchR3FReady() {
    if (R3F_READY_CHECK_INTERVAL) return;
    R3F_READY_CHECK_INTERVAL = setInterval(function () {
      if (STATE.gaugeT >= 1) { clearInterval(R3F_READY_CHECK_INTERVAL); return; }
      var r3f = document.querySelector('canvas[class*="r3f"], canvas[class*="Canvas"], canvas[data-r3f], canvas');
      // Crude heuristic: if any canvas other than ours has non-zero size, the scene likely painted.
      var canvases = document.querySelectorAll('canvas');
      for (var i = 0; i < canvases.length; i++) {
        var c = canvases[i];
        if (c === CANVAS) continue;
        var rect = c.getBoundingClientRect();
        if (rect.width > 40 && rect.height > 40) {
          completeBoot();
          clearInterval(R3F_READY_CHECK_INTERVAL);
          return;
        }
      }
    }, 250);
  }

  function setMode(mode) {
    STATE.mode = mode;
    if (mode === 'red') {
      ROOT.style.color = COLORS.red.cyan;
      TOGGLE_LED.style.background = '#ff5a5a';
      TOGGLE_LED.style.boxShadow = '0 0 8px 2px #ff5a5a';
    } else {
      ROOT.style.color = COLORS.cyan.cyan;
      TOGGLE_LED.style.background = '#7fffed';
      TOGGLE_LED.style.boxShadow = '0 0 8px 2px #7fffed';
    }
  }

  TOGGLE.addEventListener('click', function () {
    STATE.engaged = !STATE.engaged;
    if (STATE.engaged) {
      STATE.speed = Math.min(3, STATE.speed + 0.4);
      setMode('red');
    } else {
      STATE.speed = Math.max(1, STATE.speed - 0.4);
      setMode('cyan');
    }
  });

  function loop(t) {
    STATE.t = t / 1000;

    // Smooth mouse tracking with offset delay
    STATE.tx = lerp(STATE.tx, STATE.px, 0.08);
    STATE.ty = lerp(STATE.ty, STATE.py, 0.08);
    var cx = W / 2, cy = H / 2;
    var offX = (STATE.tx - 50) / 50 * Math.min(W, H) * 0.06;
    var offY = (STATE.ty - 50) / 50 * Math.min(W, H) * 0.06;
    CORE.style.transform = 'translate(calc(-50% + ' + offX + 'px), calc(-50% + ' + offY + 'px))';

    var colors = pick(STATE.mode);
    drawBackground(colors, STATE.t);
    drawStars({ speed: STATE.speed, engaged: STATE.engaged, t: STATE.t }, STATE.t, colors);
    drawHUD(colors, STATE.t);
    pushLog(colors);
    updateGauge(0.016, colors);

    requestAnimationFrame(loop);
  }

  function init() {
    initStars();
    resize();
    setMode('cyan');
    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', function (e) {
      var rect = WRAP.getBoundingClientRect();
      STATE.px = clamp(((e.clientX - rect.left) / rect.width) * 100, 0, 100);
      STATE.py = clamp(((e.clientY - rect.top) / rect.height) * 100, 0, 100);
    });
    window.addEventListener('touchmove', function (e) {
      if (!e.touches || !e.touches.length) return;
      var t = e.touches[0];
      var rect = WRAP.getBoundingClientRect();
      STATE.px = clamp(((t.clientX - rect.left) / rect.width) * 100, 0, 100);
      STATE.py = clamp(((t.clientY - rect.top) / rect.height) * 100, 0, 100);
    }, { passive: true });
    // Also track mouse position relative to the HUD core for the offset delay
    document.addEventListener('mousemove', function (e) {
      var rect = WRAP.getBoundingClientRect();
      STATE.px = clamp(((e.clientX - rect.left) / rect.width) * 100, 0, 100);
      STATE.py = clamp(((e.clientY - rect.top) / rect.height) * 100, 0, 100);
    });

    requestAnimationFrame(loop);
    watchR3FReady();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<style is:global>
  #boot-hud {
    display: flex;
    align-items: center;
    justify-content: center;
